# Backend - Node.js / TypeScript / Express / Prisma

# ============================================
# DEPENDENCIAS
# ============================================
# Nota: package-lock.json SÍ debe commitearse para asegurar versiones consistentes
# yarn.lock
# pnpm-lock.yaml
node_modules/
**/node_modules/
!node_modules/.gitkeep
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos específicos dentro de node_modules que no deben rastrearse
node_modules/.package-lock.json
node_modules/.bin/
node_modules/.prisma/
node_modules/@prisma/
node_modules/@types/

# ============================================
# BUILD OUTPUT
# ============================================
dist/
build/
*.tsbuildinfo

# ============================================
# VARIABLES DE ENTORNO (CRÍTICO - NUNCA commitees)
# ============================================
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
.env.*.local

# ============================================
# LOGS
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ============================================
# RUNTIME DATA
# ============================================
pids/
*.pid
*.seed
*.pid.lock

# ============================================
# COVERAGE / TESTING
# ============================================
coverage/
*.lcov
.nyc_output/
.coverage/

# ============================================
# DEPENDENCY DIRECTORIES
# ============================================
jspm_packages/

# ============================================
# CACHE
# ============================================
# TypeScript cache
*.tsbuildinfo

# npm cache
.npm

# eslint cache
.eslintcache

# Node REPL history
.node_repl_history

# ============================================
# PACKAGE MANAGER
# ============================================
# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# ============================================
# PRISMA
# ============================================
# Nota: Las migraciones SÍ deben commitearse, pero no el cliente generado
# El cliente se genera con: npx prisma generate

# Cliente generado de Prisma
**/.prisma/client/
node_modules/.prisma/client/
node_modules/@prisma/client/

# Directorios de Prisma en node_modules
**/node_modules/.prisma/
**/node_modules/@prisma/
**/node_modules/@prisma/client/

# Archivos binarios de Prisma
**/node_modules/.bin/

# Directorio temporal de Prisma (si se crea)
.prisma/

# ============================================
# IDE / EDITORES
# ============================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ============================================
# OS FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================
# ARCHIVOS TEMPORALES
# ============================================
*.tmp
*.temp
.cache/

# Archivos placeholder
**/.placeholder.*
.placeholder.*

# ============================================
# DOCKER
# ============================================
postgres_data/
docker-compose.override.yml

# ============================================
# OTRAS HERRAMIENTAS
# ============================================
# Prettier
.prettierignore

# EditorConfig
.editorconfig
